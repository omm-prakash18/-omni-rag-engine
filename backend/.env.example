# ─────────────────────────────────────────────────────────────────────────────
# Omni-Perspective Engine — Environment Configuration
# Single Unified API Key Configuration (Gemini API)
# ─────────────────────────────────────────────────────────────────────────────

# Single Required API Key: Gemini API Key
# Obtain free from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model & Embedding Selection
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Database Configuration (SQLite default, zero-setup)
DATABASE_URL=sqlite+aiosqlite:///./omni_perspective.db

# Vector Store (Local embedded Qdrant, zero-setup)
QDRANT_MODE=local
QDRANT_COLLECTION=omni_chunks
QDRANT_LOCAL_PATH=./qdrant_storage

# Graph Database (Optional local Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Ingestion Settings
INGESTION_INTERVAL_SECONDS=3600
INGESTION_QUERIES=["US inflation rate", "Federal Reserve interest rates", "global GDP growth"]

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:5500"]
